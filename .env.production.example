# 生产环境配置模板（不提交真实值）
#
# 用法：部署时复制到服务器 `.env` 并填入真实值，然后：
#   php artisan key:generate --force
#   php artisan migrate --force
#   php artisan config:cache && php artisan route:cache && php artisan view:cache
#
# 完整核对清单见 docs/deployment-checklist.md
# 本文件不含任何真实密钥/密码，占位符一律用 REPLACE_ME 标记，部署前必须全部替换。

APP_NAME="通用管理后台"
APP_ENV=production
APP_KEY=REPLACE_ME            # 执行 `php artisan key:generate --force` 生成，切勿复用其它环境
APP_DEBUG=false               # 生产必须关闭：开启会泄露堆栈与配置
APP_URL=https://REPLACE_ME    # 实际域名（含 scheme，影响生成链接与密码重置）

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_TIMEZONE=Asia/Shanghai

# 后台管理面板路径前缀（建议生产改为非默认值，降低被扫描命中概率）
APP_ADMIN_PREFIX=REPLACE_ME

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily               # 按天切分，配合容器/宿主机日志轮转
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error               # 生产不记录 debug/info，避免日志噪声与敏感信息落盘

# 数据库：使用最小权限账号（仅本项目库，禁用 root）
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=REPLACE_ME
DB_USERNAME=REPLACE_ME
DB_PASSWORD=REPLACE_ME        # 强随机密码（openssl rand -base64 24）

# 会话：加密存储 + 仅 HTTPS 传输
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# 缓存：登录限流与验证码计数依赖缓存，生产建议 redis
#   redis 需同步配置下方 REDIS_*；沿用 database 也可，但高频限流会给数据库加压
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# 邮件：当前MAIL_MAILER=log（写日志不发信）—— 需真实发信时改为 smtp 并填入凭据
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=REPLACE_ME
MAIL_PORT=587
MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME
MAIL_FROM_ADDRESS="REPLACE_ME"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# WebSocket 实时推送（GatewayWorker）
# 关闭时通知铃铛自动退化为 60 秒轮询，功能不受影响
WS_ENABLED=false
# 浏览器可见地址默认由 APP_URL 推导（https://域名 → wss://域名/ws，配合 Nginx 反代 /ws）。
# 只有当 WS 与 HTTP 不同域名/端口时才需要显写，例如本地直连：WS_PUBLIC_URL="ws://127.0.0.1:2346"
# WS_PUBLIC_URL="wss://REPLACE_ME/ws"
WS_REGISTER_ADDRESS="127.0.0.1:1236"
WS_LISTEN="0.0.0.0:2346"
WS_LAN_IP="127.0.0.1"
WS_START_PORT=2300
WS_WORKER_COUNT=2
WS_TICKET_TTL=60
# 连接票据的存储。留空则跟随 CACHE_STORE（这里是 database，能用但代价高：
# 每次建连一次 INSERT+DELETE，且常驻 Worker 持有 MySQL 长连接会被 wait_timeout 断开）。
# 生产建议显式指定 redis；绝不能用 array/null——票据由 php-fpm 签发、Worker 消费，
# 进程内存不共享，配错的表现是「连上就断」且很难排查。
WS_TICKET_STORE=redis

# 操作日志保留天数（超期由每日 model:prune 清理，默认 90）
OPERATION_LOG_RETENTION_DAYS=90

# 数据库备份（spatie/laravel-backup，每日 02:00 由调度执行）
# 告警收件人：留空则回落到 MAIL_FROM_ADDRESS
BACKUP_NOTIFY_EMAIL=
# 7 天内保留全部备份，之后按日/周/月/年递减保留
BACKUP_KEEP_ALL_DAYS=7
# 备份目录占用上限（MB），超出后从最旧开始删
BACKUP_MAX_STORAGE_MB=5000
# 超过该天数没有新备份即判定不健康并告警
BACKUP_MAX_AGE_DAYS=1
# mysqldump 所在目录：留空＝运行时自动探测（PATH → 常见安装目录），
# 仅在自动识别失败时才手工指定，例如 DB_DUMP_BINARY_PATH=/usr/local/mysql/bin
DB_DUMP_BINARY_PATH=

# 健康检查（/health 免登录探活；/health/detailed 需内网或 token）
# 深度自检访问令牌：留空＝仅允许内网 IP（10/172.16/192.168/127.0.0.1）
HEALTH_TOKEN=
# 判定不健康的阈值：磁盘剩余下限（MB）、队列挂起上限（条）
HEALTH_DISK_FREE_MIN_MB=500
HEALTH_QUEUE_PENDING_MAX=50

# 跨域白名单（逗号分隔）：留空＝不放行任何跨域来源
CORS_ALLOWED_ORIGINS=
# 是否允许跨域携带 Cookie，默认关闭
CORS_SUPPORTS_CREDENTIALS=false

# 异地备份（阿里云 OSS）——四项配置齐全才启用，缺任一项则只做本地备份
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
# 地域节点，例：https://oss-cn-hangzhou.aliyuncs.com（内网可换 -internal 端点）
OSS_ENDPOINT=
OSS_BUCKET=
# 桶内目录前缀，默认 backups
OSS_PREFIX=backups
# 用自定义域名绑定 bucket 时才置 true
OSS_IS_CNAME=false
